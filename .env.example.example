# Copy this file to .env and fill in your key(s).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables vector search in 02_rag.py (otherwise keyword search is used),
# or lets you switch MODEL to an OpenAI model.
OPENAI_API_KEY=

# Any "provider:model" string; change this one line to switch providers.
MODEL=anthropic:claude-sonnet-5-5
SMALL_MODEL=anthropic:claude-haiku-5-5
# MODEL=openai:gpt-4o
